# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# build artifacts (published as GitHub Releases, not committed)
*.apk
*.aab
*.ipa

# signing key — never commit, the app can never be updated again if this leaks
*.keystore
/firma/

# certificados que descarga Play Console (públicos, pero no pintan nada aquí)
certificates*.zip
*.der

# scratch / cleanup staging
/_to_delete/
/_to_delete_entrega/
/_to_delete_entrega2/

# trastos que caen en la carpeta del proyecto y no son del proyecto: modelos 3D
# de la peana impresa, instaladores de DJI, manuales y los PDF de mis propios
# trámites (que llevan datos personales dentro)
*.stl
*.exe
/DJI_Mini_2_User_Manual_ES.pdf
/Formato-Solicitud-Comunicacion.pdf
/C0000496822-*.pdf
/qr-code.png
/EARO_*.docx
