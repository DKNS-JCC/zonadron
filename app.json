{
  "expo": {
    "name": "Zona Dron",
    "slug": "zonadron",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zonadron",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.zonadron.app",
      "buildNumber": "3",
      "requireFullScreen": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Zona Dron usa tu ubicación para comprobar si el punto donde estás se encuentra dentro de una zona geográfica UAS publicada por ENAIRE.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "es.zonadron.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zona Dron usa tu ubicación para comprobar si el punto donde estás se encuentra dentro de una zona geográfica UAS publicada por ENAIRE."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220"
        }
      ],
      "expo-localization",
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Zona Dron UAS",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/plain"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ZonaDronUAS",
                  "bundleIdentifier": "es.zonadron.app.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.es.zonadron.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f96f30b3-7b79-41fa-8dd9-68cd306d5f26"
      }
    }
  }
}
